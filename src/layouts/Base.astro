---
import "../styles/global.css";
import QuoteModal from "../components/QuoteModal.astro";
import { contact, hours, serviceArea, site } from "../data/site";

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ?? `${contact.name} — ${site.tagline}`;
const canonical = site.url; // single-page site
const favicon = `${import.meta.env.BASE_URL}/favicon-180.png`.replace(/\/{2,}/g, "/");
const appleIcon = `${import.meta.env.BASE_URL}/favicon-512.png`.replace(/\/{2,}/g, "/");

const dayMap: Record<string, string> = {
  Monday: "Mo", Tuesday: "Tu", Wednesday: "We", Thursday: "Th",
  Friday: "Fr", Saturday: "Sa", Sunday: "Su",
};
const openingHours = hours.map((h) => `${dayMap[h.day]} ${h.open}-${h.close}`);

// RoofingContractor schema (a LocalBusiness subtype). areaServed carries the
// six municipalities — for a trade with no storefront, that does the work a
// street address does for a restaurant.
//
// NOTE: no aggregateRating. Never emit one until there are real, first-party
// reviews to back it; a made-up rating in JSON-LD is a manual-action risk.
//
// TODO: once a real street address is confirmed, add PostalAddress + geo. It
// is deliberately omitted rather than emitted empty — an empty streetAddress is
// worse than no address at all.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: contact.name,
  description: site.description,
  slogan: site.promise,
  telephone: contact.phoneTel,
  email: contact.email,
  url: site.url,
  areaServed: serviceArea.cities.map((city) => ({
    "@type": "City",
    name: city,
    containedInPlace: { "@type": "AdministrativeArea", name: "British Columbia" },
  })),
  address: {
    "@type": "PostalAddress",
    addressLocality: contact.city,
    addressRegion: contact.region,
    addressCountry: "CA",
  },
  openingHours,
  sameAs: [contact.messenger],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Sets the gate that lets motion.css hide reveal targets. It has to run
         before first paint and before the deferred module: if it waited, every
         revealing element would paint visible and then snap hidden. The
         corollary is that a JS failure leaves the whole page visible. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <!-- The mark on its cream ground — a transparent favicon would lose the
         charcoal against a dark browser chrome. -->
    <link rel="icon" type="image/png" sizes="180x180" href={favicon} />
    <link rel="apple-touch-icon" href={appleIcon} />

    <!-- TEMPLATE ONLY — remove at launch. This build still contains a fictional
         phone number and sample testimonials; it must not be crawled. -->
    <meta name="robots" content="noindex, nofollow" />

    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1a1815" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#quote">Skip to getting a quote</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>

    <!--
      The vendor's own embed.js floating widget never rendered anything
      visible, across two corrected slugs and a confirmed-active dashboard
      account — dropped in favour of QuoteModal, which iframes the flow's own
      page directly and is verified working. See data/site.ts (bookingFlowUrl)
      for the URL this points at.
    -->
    <QuoteModal />
  </body>
</html>
