---
import "../styles/global.css";
import { contact, hours, serviceArea, site } from "../data/site";

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ?? `${contact.name} — ${site.tagline}`;
const canonical = site.url; // single-page site
const favicon = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/{2,}/g, "/");

const dayMap: Record<string, string> = {
  Monday: "Mo", Tuesday: "Tu", Wednesday: "We", Thursday: "Th",
  Friday: "Fr", Saturday: "Sa", Sunday: "Su",
};
const openingHours = hours.map((h) => `${dayMap[h.day]} ${h.open}-${h.close}`);

// RoofingContractor schema (a LocalBusiness subtype). areaServed carries the
// six municipalities — for a trade with no storefront, that does the work a
// street address does for a restaurant.
//
// NOTE: no aggregateRating. Never emit one until there are real, first-party
// reviews to back it; a made-up rating in JSON-LD is a manual-action risk.
//
// TODO: once a real street address is confirmed, add PostalAddress + geo. It
// is deliberately omitted rather than emitted empty — an empty streetAddress is
// worse than no address at all.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: contact.name,
  description: site.description,
  slogan: site.promise,
  telephone: contact.phoneTel,
  email: contact.email,
  url: site.url,
  areaServed: serviceArea.cities.map((city) => ({
    "@type": "City",
    name: city,
    containedInPlace: { "@type": "AdministrativeArea", name: "British Columbia" },
  })),
  address: {
    "@type": "PostalAddress",
    addressLocality: contact.city,
    addressRegion: contact.region,
    addressCountry: "CA",
  },
  openingHours,
  sameAs: [contact.messenger],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />

    <!-- TEMPLATE ONLY — remove at launch. This build still contains a fictional
         phone number and sample testimonials; it must not be crawled. -->
    <meta name="robots" content="noindex, nofollow" />

    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2e2a26" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#quote">Skip to getting a quote</a>
    <slot />
  </body>
</html>
