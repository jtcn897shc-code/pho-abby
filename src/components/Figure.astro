---
import type { Figure } from "../data/images";

interface Props extends Figure {
  ratio?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, label, kind, ratio = "4 / 3", eager = false, class: cls } = Astro.props;
---

{
  src ? (
    <img
      class:list={["figure", cls]}
      src={src}
      alt={alt}
      style={`aspect-ratio:${ratio}`}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  ) : (
    <div
      class:list={["figure figure--ph", `figure--${kind}`, cls]}
      style={`aspect-ratio:${ratio}`}
      role="img"
      aria-label={`${alt} (photo to be added)`}
    >
      <svg class="figure__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 5.5 2.5 16.5h4V26h19v-9.5h4L16 5.5Z" fill="currentColor" />
        <rect x="20.5" y="8" width="3" height="4.2" rx="0.6" fill="currentColor" />
      </svg>
      <span class="figure__label">{label}</span>
      <span class="figure__hint">photo to come</span>
    </div>
  )
}

<style>
  .figure {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder fills read as "roof": charcoal slate with a low savanna sun
     behind it. Three variants so a page of placeholders isn't one flat wall. */
  .figure--ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1rem;
    color: #fff;
    background:
      radial-gradient(110% 80% at 78% 12%, oklch(0.78 0.135 85 / 0.45), transparent 58%),
      linear-gradient(155deg, oklch(0.42 0.012 60), oklch(0.26 0.008 60));
  }

  .figure--crew {
    background:
      radial-gradient(110% 85% at 22% 8%, oklch(0.48 0.11 150 / 0.45), transparent 60%),
      linear-gradient(160deg, oklch(0.38 0.012 60), oklch(0.24 0.008 60));
  }

  .figure--damage {
    background:
      radial-gradient(120% 95% at 50% 105%, oklch(0.78 0.135 85 / 0.3), transparent 55%),
      linear-gradient(150deg, oklch(0.33 0.01 60), oklch(0.22 0.008 60));
  }

  .figure__mark {
    width: 34px;
    height: 34px;
    color: oklch(1 0 0 / 0.9);
  }

  .figure__label {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .figure__hint {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(1 0 0 / 0.6);
  }
</style>
