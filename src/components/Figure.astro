---
import type { Figure } from "../data/images";

interface Props extends Figure {
  ratio?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, label, kind, ratio = "4 / 3", eager = false, class: cls } = Astro.props;
---

{
  src ? (
    <img
      class:list={["figure", cls]}
      src={src}
      alt={alt}
      style={`aspect-ratio:${ratio}`}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  ) : (
    <div
      class:list={["figure figure--ph", `figure--${kind}`, cls]}
      style={`aspect-ratio:${ratio}`}
      role="img"
      aria-label={`${alt} (photo to be added)`}
    >
      <svg class="figure__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M5 14h22a11 11 0 0 1-22 0Z" fill="currentColor" />
        <rect x="3" y="21.5" width="26" height="2.4" rx="1.2" fill="currentColor" />
        <path
          d="M12 7.5c1.6 1.2 1.6 2.6 0 3.8M16 6c1.8 1.4 1.8 3 0 4.4M20 7.5c1.6 1.2 1.6 2.6 0 3.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.7"
        />
      </svg>
      <span class="figure__label">{label}</span>
      <span class="figure__hint">photo to come</span>
    </div>
  )
}

<style>
  .figure {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .figure--ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1rem;
    color: #fff;
    background:
      radial-gradient(120% 90% at 30% 10%, oklch(0.62 0.14 62 / 0.55), transparent 60%),
      radial-gradient(120% 120% at 90% 100%, oklch(0.34 0.09 40 / 0.7), transparent 55%),
      linear-gradient(150deg, oklch(0.5 0.12 52), oklch(0.36 0.09 44));
  }

  .figure--room {
    background:
      radial-gradient(120% 90% at 20% 0%, oklch(0.7 0.05 70 / 0.5), transparent 55%),
      linear-gradient(160deg, oklch(0.42 0.05 60), oklch(0.29 0.035 55));
  }

  .figure__mark {
    width: 34px;
    height: 34px;
    color: oklch(1 0 0 / 0.9);
  }

  .figure__label {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .figure__hint {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(1 0 0 / 0.6);
  }
</style>
