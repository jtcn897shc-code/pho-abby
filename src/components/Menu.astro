---
import { menu } from "../data/site";

const fmt = (p: string) => {
  if (p === "0") return null;
  const n = Number(p);
  return Number.isFinite(n) ? `$${n.toFixed(2).replace(/\.00$/, "")}` : `$${p}`;
};
---

<section class="section menu" id="menu">
  <div class="shell">
    <div class="section-head">
      <h2>The menu</h2>
      <p>
        Rice-noodle phở, grilled lemongrass plates, salad rolls and bubble tea.
        Vegetarian options in every section.
      </p>
    </div>

    <div class="menu__grid">
      {
        menu.map((group) => (
          <div class:list={["menu__group", { "menu__group--wide": group.items.length > 4 }]}>
            <h3>
              {group.name}
              {group.placeholder && <span class="menu__sample">sample</span>}
            </h3>
            {group.note && <p class="menu__note">{group.note}</p>}
            <dl class="menu__rows">
              {group.items.map((item) => (
                <div class="menu__row">
                  <dt>
                    <span class="menu__name">{item.name}</span>
                    {item.tag && <span class="pill">{item.tag}</span>}
                    {item.note && <span class="menu__desc">{item.note}</span>}
                  </dt>
                  <dd>{fmt(item.price) ?? <span class="menu__free">on the house</span>}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <p class="menu__disclaimer">
      Preview build — starters are Pho Abby's real menu; the rest is a sample
      layout pending the full menu and prices.
    </p>
  </div>
</section>

<style>
  .menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  .menu__group--wide {
    grid-column: span 2;
  }

  .menu__group h3 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--primary);
    padding-bottom: var(--s-3);
    border-bottom: 2px solid var(--primary);
  }

  .menu__sample {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.5rem;
  }

  .menu__note {
    margin-top: var(--s-3);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .menu__rows {
    margin-top: var(--s-4);
  }

  .menu__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0 0.75rem;
    padding: 0.55rem 0;
  }

  .menu__row + .menu__row {
    border-top: 1px dotted var(--hairline);
  }

  .menu__row dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
  }

  .menu__name {
    font-weight: 500;
  }

  .menu__desc {
    flex-basis: 100%;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .menu__row dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .menu__free {
    font-size: 0.85rem;
    font-weight: 600;
    font-style: italic;
    color: var(--accent-deep);
  }

  .menu__disclaimer {
    margin-top: var(--s-12);
    font-size: 0.82rem;
    color: var(--muted);
    max-width: 60ch;
  }

  @media (max-width: 620px) {
    .menu__grid {
      grid-template-columns: 1fr;
    }
    .menu__group--wide {
      grid-column: auto;
    }
  }
</style>
