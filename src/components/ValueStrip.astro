---
import { valueStrip } from "../data/site";
---

<section class="strip">
  <ul class="shell strip__list">
    {valueStrip.map((phrase) => <li>{phrase}</li>)}
  </ul>
</section>

<style>
  /* Charcoal text on the gold field — white on this gold is 2.3:1 and fails. */
  .strip {
    background: var(--primary);
    color: var(--on-primary);
    padding-block: clamp(1.5rem, 4vw, 2.25rem);
  }

  .strip__list {
    list-style: none;
    padding-inline: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }

  .strip__list li {
    position: relative;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    padding-left: 1.4rem;
  }

  .strip__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-deep);
  }

  @media (max-width: 620px) {
    .strip__list {
      flex-direction: column;
      gap: 0.65rem;
    }
  }
</style>
