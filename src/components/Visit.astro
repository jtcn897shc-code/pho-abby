---
import { contact, hours, hoursFootnote, orderLinks } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapsQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.mapsQuery)}`;

const to12 = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  const ap = h >= 12 ? "pm" : "am";
  const hh = h % 12 === 0 ? 12 : h % 12;
  return m === 0 ? `${hh} ${ap}` : `${hh}:${String(m).padStart(2, "0")} ${ap}`;
};
---

<section class="section visit" id="visit">
  <div class="shell visit__inner">
    <div class="visit__details">
      <div class="section-head">
        <h2>Come in</h2>
      </div>

      <address class="visit__address">
        <a href={mapLink} target="_blank" rel="noopener">
          {contact.street}<br />
          {contact.city}, {contact.region} {contact.postal}
        </a>
        <span class="visit__hint">{contact.neighbourhood}</span>
      </address>

      <a class="visit__phone" href={`tel:${contact.phoneTel}`}>{contact.phoneDisplay}</a>

      <dl class="hours" data-hours>
        {
          hours.map((h, i) => (
            <div class="hours__row" data-day={i}>
              <dt>{h.day}</dt>
              <dd>
                {to12(h.open)} – {to12(h.close)}
                <span class="hours__state" hidden></span>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="hours__foot">{hoursFootnote}</p>

      <div class="visit__cta">
        <a class="btn" href={orderLinks.pickup.href}>{orderLinks.pickup.label}</a>
        <a
          class="btn--ghost"
          href={orderLinks.delivery.href}
          target={orderLinks.delivery.href.startsWith("http") ? "_blank" : undefined}
          rel="noopener"
        >
          {orderLinks.delivery.label}
        </a>
      </div>
      <p class="visit__parking">Free parking in the plaza lot. Wheelchair accessible; high chairs available.</p>
    </div>

    <div class="visit__map">
      <iframe
        src={mapSrc}
        title={`Map to ${contact.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .visit__inner {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }

  .visit__address {
    font-style: normal;
  }

  .visit__address a {
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 1px;
  }

  .visit__address a:hover {
    color: var(--primary);
  }

  .visit__hint {
    display: block;
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .visit__phone {
    display: inline-block;
    margin-top: var(--s-6);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--primary);
    text-decoration: none;
    min-height: 44px;
  }

  .visit__phone:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hours {
    margin-top: var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.95rem;
  }

  .hours__row dt {
    color: var(--muted);
  }

  .hours__row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .hours__row.is-today dt,
  .hours__row.is-today dd {
    color: var(--ink);
    font-weight: 700;
  }

  .hours__row.is-today dt {
    position: relative;
    padding-left: 1rem;
  }

  .hours__row.is-today dt::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hours__state {
    margin-left: 0.5rem;
    font-weight: 700;
    font-size: 0.82rem;
  }

  .hours__state[data-open="yes"] {
    color: var(--accent-deep);
  }

  .hours__state[data-open="no"] {
    color: var(--muted);
  }

  .hours__foot {
    margin-top: var(--s-3);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .visit__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  .visit__parking {
    margin-top: var(--s-4);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .visit__map {
    position: sticky;
    top: 5.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 5;
  }

  .visit__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 980px) {
    .visit__inner {
      grid-template-columns: 1fr;
    }
    .visit__map {
      position: static;
      order: -1;
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script>
  // Mark today's row and compute open/closed in America/Vancouver, client-side
  // (build-time "today" would be wrong). Colour is not the only signal — the
  // day goes bold and an "· open now / closed" label is added.
  type Row = { open: string; close: string };
  const rows: Row[] = [
    { open: "10:00", close: "21:00" },
    { open: "10:00", close: "21:00" },
    { open: "10:00", close: "21:00" },
    { open: "10:00", close: "21:00" },
    { open: "10:00", close: "21:00" },
    { open: "10:00", close: "21:00" },
    { open: "10:00", close: "20:30" },
  ];

  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/Vancouver",
    weekday: "short",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).formatToParts(new Date());

  const wd = parts.find((p) => p.type === "weekday")?.value ?? "Mon";
  const hour = Number(parts.find((p) => p.type === "hour")?.value ?? "0");
  const min = Number(parts.find((p) => p.type === "minute")?.value ?? "0");
  const nowMin = hour * 60 + min;

  const order = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const idx = order.indexOf(wd); // 0 = Monday, matches data order

  if (idx > -1) {
    const container = document.querySelector("[data-hours]");
    const row = container?.querySelector<HTMLElement>(`[data-day="${idx}"]`);
    if (row) {
      row.classList.add("is-today");
      const [oh, om] = rows[idx].open.split(":").map(Number);
      const [ch, cm] = rows[idx].close.split(":").map(Number);
      const openMin = oh * 60 + om;
      const closeMin = ch * 60 + cm;
      const isOpen = nowMin >= openMin && nowMin < closeMin;
      const state = row.querySelector<HTMLElement>(".hours__state");
      if (state) {
        state.hidden = false;
        state.textContent = isOpen ? "· open now" : "· closed now";
        state.dataset.open = isOpen ? "yes" : "no";
      }
    }
  }
</script>
