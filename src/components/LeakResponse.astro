---
import { leakResponse, reviews } from "../data/site";
import { images } from "../data/images";
import Figure from "./Figure.astro";

const imgFor = {
  leakResponse: images.leakResponse,
  inspection: images.inspection,
  flatRoof: images.flatRoof,
} as const;
---

<section class="section section--void leak" id="leak-response">
  <span class="ghost" aria-hidden="true">In the rain</span>

  <div class="shell section__inner">
    <header class="leak__head">
      <p class="eyebrow" data-reveal="up">02 — Leak response</p>
      <h2 class="display h2" data-reveal="up" style="--i:1">
        When the water's<br /><span class="display--ghost-gold">already in.</span>
      </h2>
      <p class="lede" data-reveal="up" style="--i:2">{leakResponse.lede}</p>
    </header>

    <article class="feature" data-reveal="mask" data-tilt="4">
      <div class="feature__media">
        <Figure {...imgFor[leakResponse.feature.img]} ratio="16 / 10" />
      </div>
      <div class="feature__text">
        <h3 class="display feature__title">{leakResponse.feature.title}</h3>
        <p>{leakResponse.feature.body}</p>
      </div>
    </article>

    <ol class="steps">
      {
        leakResponse.steps.map((s, i) => (
          <li class="step" data-reveal="swing" style={`--i:${i}`}>
            <div class="step__media">
              <Figure {...imgFor[s.img]} ratio="16 / 10" />
              <span class="step__num display">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
          </li>
        ))
      }
    </ol>

    <ul class="quotes">
      {
        reviews.map((r, i) => (
          <li class:list={["quote", { "quote--ph": r.placeholder }]} data-reveal="up" style={`--i:${i}`}>
            <span class="quote__mark" aria-hidden="true">
              “
            </span>
            <p>{r.quote}</p>
            <cite>
              {r.name}
              <span>{r.source}</span>
            </cite>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .leak__head {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .leak__head .lede {
    margin-top: var(--s-6);
  }

  /* ---- feature ---- */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--void-2);
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .feature__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .feature__media > :global(*) {
    width: 100%;
    height: 100%;
    transition: transform 600ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .feature:hover .feature__media > :global(*) {
      transform: scale(1.04);
    }
  }

  .feature__text {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    padding-left: 0;
  }

  .feature__title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--gold);
  }

  .feature__text p {
    margin-top: var(--s-4);
    color: var(--on-void-dim);
    max-width: 42ch;
  }

  /* ---- steps ---- */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .step__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .step__media > :global(*) {
    width: 100%;
    height: 100%;
  }

  .step__num {
    position: absolute;
    left: 0.75rem;
    bottom: 0.35rem;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--gold);
  }

  .step__title {
    margin-top: var(--s-4);
    font-family: var(--font);
    font-variation-settings: "wdth" 82, "wght" 800;
    font-size: var(--fs-h3);
    text-transform: uppercase;
  }

  .step__body {
    margin-top: var(--s-2);
    color: var(--on-void-dim);
    font-size: 0.95rem;
  }

  /* ---- quotes ---- */
  .quotes {
    list-style: none;
    padding: 0;
    margin-top: clamp(3rem, 7vw, 5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--hairline);
  }

  .quote__mark {
    display: block;
    font-family: var(--font);
    font-variation-settings: var(--display-axes);
    font-size: 3rem;
    line-height: 0.6;
    color: var(--gold);
  }

  .quote p {
    margin-top: var(--s-3);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  /* Sample testimonials stay visibly marked so nobody mistakes them for real
     reviews during a pitch. See the note in data/site.ts. */
  .quote--ph {
    opacity: 0.62;
  }

  .quote--ph p {
    font-style: italic;
  }

  .quote cite {
    display: block;
    margin-top: var(--s-4);
    font-style: normal;
    font-family: var(--font);
    font-variation-settings: "wdth" 88, "wght" 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .quote cite span {
    display: block;
    font-variation-settings: "wdth" 88, "wght" 500;
    letter-spacing: 0.08em;
    color: var(--on-void-dim);
    margin-top: 0.15rem;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature__text {
      padding: clamp(1.25rem, 4vw, 2rem);
      padding-top: 0;
    }
  }
</style>
