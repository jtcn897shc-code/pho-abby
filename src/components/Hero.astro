---
import { contact, ctas, serviceArea, site } from "../data/site";
import { images } from "../data/images";

const hero = images.hero;

// Wind-blown drizzle. Each streak gets its own lane, fall time and offset so
// the loop never visibly repeats. Values are hand-scattered, not generated,
// so the rhythm stays irregular.
const rain = [
  { x: "6%", d: "1.5s", delay: "-0.2s", o: 0.5 },
  { x: "14%", d: "1.9s", delay: "-1.1s", o: 0.35 },
  { x: "23%", d: "1.3s", delay: "-0.7s", o: 0.55 },
  { x: "31%", d: "2.1s", delay: "-1.5s", o: 0.3 },
  { x: "44%", d: "1.6s", delay: "-0.4s", o: 0.45 },
  { x: "52%", d: "1.25s", delay: "-0.9s", o: 0.6 },
  { x: "63%", d: "2s", delay: "-0.15s", o: 0.32 },
  { x: "71%", d: "1.45s", delay: "-1.3s", o: 0.5 },
  { x: "83%", d: "1.75s", delay: "-0.6s", o: 0.4 },
  { x: "92%", d: "1.35s", delay: "-1.8s", o: 0.55 },
];
---

<section class="hero" id="top">
  {
    hero.src ? (
      <img
        class="hero__img"
        src={hero.src}
        alt={hero.alt}
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="hero__img hero__img--ph" aria-hidden="true" />
    )
  }
  <div class="hero__scrim"></div>

  <!-- motion signature: drizzle. The problem this company solves, falling
       across the hero. Visible by default; removed entirely under
       prefers-reduced-motion. -->
  <div class="hero__rain" aria-hidden="true">
    {rain.map((r) => <span style={`--x:${r.x}; --d:${r.d}; --delay:${r.delay}; --o:${r.o}`} />)}
  </div>

  <div class="shell hero__inner">
    <p class="hero__place">{serviceArea.cities.join(" · ")}</p>
    <h1 class="hero__headline">Leaking now?<br />We'll stop the water.</h1>
    <p class="hero__sub">
      Roof-leak detection, emergency water containment and permanent repair —
      flat roofs and asphalt shingle, residential and commercial. Most roofers
      tell you to call back when it dries out. We come out in the rain.
    </p>
    <div class="hero__cta">
      <a class="btn" href={ctas.emergency.href}>
        {ctas.emergency.label} · {contact.phoneDisplay}
      </a>
      <a class="btn--ghost-on-frame" href={ctas.quote.href}>{ctas.quote.label}</a>
    </div>
    <p class="hero__promise">{site.promise}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(88svh, 780px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--frame);
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    animation: hero-settle 1.6s var(--ease-out) both;
  }

  /* placeholder hero — wet charcoal slate under a low savanna sun */
  .hero__img--ph {
    background:
      radial-gradient(70% 55% at 82% 12%, oklch(0.78 0.135 85 / 0.55), transparent 62%),
      radial-gradient(100% 80% at 20% 100%, oklch(0.3 0.01 60 / 0.9), transparent 60%),
      linear-gradient(158deg, oklch(0.44 0.014 60), oklch(0.23 0.008 60));
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.06);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      oklch(0.2 0.008 60 / 0.94) 0%,
      oklch(0.2 0.008 60 / 0.6) 36%,
      oklch(0.2 0.008 60 / 0.15) 64%,
      oklch(0.2 0.008 60 / 0.4) 100%
    );
  }

  .hero__inner {
    padding-block: clamp(2.5rem, 8vw, 5.5rem);
  }

  .hero__place {
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--s-4);
  }

  .hero__headline {
    font-size: var(--fs-display);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--on-frame);
    max-width: 16ch;
  }

  .hero__sub {
    margin-top: var(--s-6);
    max-width: 52ch;
    font-size: var(--fs-lead);
    color: var(--on-frame);
    opacity: 0.9;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  .hero__promise {
    margin-top: var(--s-6);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--on-frame-muted);
  }

  /* ---- drizzle ---- */
  .hero__rain {
    position: absolute;
    inset: -10% 0 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__rain span {
    position: absolute;
    top: -12%;
    left: var(--x);
    width: 1.5px;
    height: clamp(48px, 7vw, 84px);
    border-radius: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      oklch(0.98 0.01 85 / var(--o)),
      transparent
    );
    transform: rotate(9deg);
    animation: rain-fall var(--d) linear var(--delay) infinite;
  }

  @keyframes rain-fall {
    from {
      transform: translate3d(0, 0, 0) rotate(9deg);
    }
    to {
      transform: translate3d(-6vw, 118svh, 0) rotate(9deg);
    }
  }

  @media (max-width: 620px) {
    .hero__headline {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img {
      animation: none;
      opacity: 1;
      transform: none;
    }
    /* No static stand-in: still rain reads as scratches on the photo. */
    .hero__rain {
      display: none;
    }
  }
</style>

<script>
  // Pause the drizzle when the tab is hidden — loops don't advance off-screen
  // and can jank on return.
  const rain = document.querySelector<HTMLElement>(".hero__rain");
  if (rain) {
    document.addEventListener("visibilitychange", () => {
      const state = document.hidden ? "paused" : "running";
      rain.querySelectorAll<HTMLElement>("span").forEach((s) => {
        s.style.animationPlayState = state;
      });
    });
  }
</script>
