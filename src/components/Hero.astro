---
import { contact, ctas, serviceArea, site } from "../data/site";
import { images } from "../data/images";

const hero = images.hero;

// Wind-blown drizzle. Hand-scattered lanes so the loop never visibly repeats.
const rain = [
  { x: "6%", d: "1.5s", delay: "-0.2s", o: 0.45 },
  { x: "14%", d: "1.9s", delay: "-1.1s", o: 0.3 },
  { x: "23%", d: "1.3s", delay: "-0.7s", o: 0.5 },
  { x: "31%", d: "2.1s", delay: "-1.5s", o: 0.26 },
  { x: "44%", d: "1.6s", delay: "-0.4s", o: 0.4 },
  { x: "52%", d: "1.25s", delay: "-0.9s", o: 0.55 },
  { x: "63%", d: "2s", delay: "-0.15s", o: 0.28 },
  { x: "71%", d: "1.45s", delay: "-1.3s", o: 0.45 },
  { x: "83%", d: "1.75s", delay: "-0.6s", o: 0.35 },
  { x: "92%", d: "1.35s", delay: "-1.8s", o: 0.5 },
];
---

<section class="hero" id="top">
  <!--
    Depth is built from three planes at different translateZ inside one
    perspective. The text is deliberately NOT in the 3D context: transformed
    text rasterises soft, and a blurry headline is a bad trade for parallax
    nobody consciously notices. The planes move, the type stays crisp.
  -->
  <div class="hero__sink" aria-hidden="true">
    <div class="hero__scene">
      {
        hero.src ? (
          <img
            class="hero__img"
            src={hero.src}
            alt=""
            width="1260"
            height="1680"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero__img hero__img--ph" />
        )
      }

      <div class="hero__rain">
        {rain.map((r) => <span style={`--x:${r.x}; --d:${r.d}; --delay:${r.delay}; --o:${r.o}`} />)}
      </div>

      <div class="hero__scrim"></div>
    </div>
  </div>

  <div class="shell hero__inner">
    <p class="hero__place" data-reveal="up">
      <span class="hero__dot"></span>
      {serviceArea.cities.join(" · ")}
    </p>

    <h1 class="hero__headline display mega hinge">
      <span class="hinge__line"><span class="hinge__inner" style="--i:0">Leaking now?</span></span>
      <span class="hinge__line"
        ><span class="hinge__inner display--ghost-gold" style="--i:1">We'll stop</span></span
      >
      <span class="hinge__line"
        ><span class="hinge__inner display--ghost-gold" style="--i:2">the water.</span></span
      >
    </h1>

    <div class="hero__foot">
      <p class="hero__sub" data-reveal="up" style="--i:4">
        Roof-leak detection, emergency water containment and permanent repair —
        flat roofs and asphalt shingle, residential and commercial. Most roofers
        tell you to call back when it dries out. <strong>We come out in the rain.</strong>
      </p>

      <div class="hero__cta" data-reveal="up" style="--i:5">
        <a class="btn" href={ctas.emergency.href}>
          {contact.phoneDisplay}
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a
          class="btn--ghost"
          href={ctas.quote.href}
          target="_blank"
          rel="noopener"
          data-open-quote-modal
        >
          Request a quote
        </a>
      </div>
    </div>

    <p class="hero__promise" data-reveal="up" style="--i:6">{site.promise}</p>
  </div>

  <div class="hero__edge" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, 900px);
    display: flex;
    align-items: flex-end;
    overflow: clip;
    background: var(--void);
    perspective: 1400px;
    perspective-origin: 50% 40%;
  }

  /* Scroll-linked sink. Pure CSS scroll timeline where supported, so it runs
     on the compositor and keeps its frames while the page is still loading
     images. Everywhere else it simply never moves — the hero is still a hero. */
  .hero__sink {
    position: absolute;
    inset: 0;
    z-index: -1;
    transform-style: preserve-3d;
  }

  @supports (animation-timeline: view()) {
    .hero__sink {
      animation: hero-sink linear both;
      animation-timeline: view(block);
      animation-range: exit-crossing 0% exit 100%;
    }
  }

  @keyframes hero-sink {
    to {
      transform: translate3d(0, 6%, 0) rotateX(9deg) scale(0.94);
      opacity: 0.4;
    }
  }

  .hero__scene {
    position: absolute;
    inset: -6%;
    transform-style: preserve-3d;
    animation: scene-in var(--dur-scene) var(--ease-out) both;
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      transform: translate3d(0, 2%, -120px) scale(1.06);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Plane 1 — the photograph, pushed back. The scale compensates for the
     perspective shrink so it still fills the frame. */
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 68%;
    transform: translate3d(0, 0, -140px) scale(1.14);
  }

  .hero__img--ph {
    background:
      radial-gradient(70% 55% at 82% 12%, oklch(0.78 0.135 85 / 0.5), transparent 62%),
      linear-gradient(158deg, oklch(0.4 0.014 60), oklch(0.18 0.008 60));
  }

  /* Plane 2 — weather, nearer the viewer than the roof it falls on. */
  .hero__rain {
    position: absolute;
    inset: -12% 0 0;
    transform: translate3d(0, 0, -40px);
    pointer-events: none;
  }

  .hero__rain span {
    position: absolute;
    top: -12%;
    left: var(--x);
    width: 1.5px;
    height: clamp(48px, 7vw, 84px);
    border-radius: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      oklch(0.98 0.01 85 / var(--o)),
      transparent
    );
    animation: rain-fall var(--d) linear var(--delay) infinite;
  }

  @keyframes rain-fall {
    from {
      transform: translate3d(0, 0, 0) rotate(9deg);
    }
    to {
      transform: translate3d(-6vw, 128svh, 0) rotate(9deg);
    }
  }

  /* Plane 3 — the scrim sits closest, so the type never fights the photo. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    transform: translate3d(0, 0, 10px);
    background:
      linear-gradient(
        to right,
        oklch(0.16 0.006 60 / 0.92) 0%,
        oklch(0.16 0.006 60 / 0.55) 46%,
        oklch(0.16 0.006 60 / 0.15) 78%
      ),
      linear-gradient(
        to top,
        oklch(0.16 0.006 60) 2%,
        oklch(0.16 0.006 60 / 0.72) 32%,
        oklch(0.16 0.006 60 / 0.2) 62%,
        oklch(0.16 0.006 60 / 0.5) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    /* Must clear the nav's fixed pull-up at every width — a vw-only clamp
       drops under it on phones and the first line lands behind the bar. */
    padding-top: calc(4.5rem + clamp(1.5rem, 4vw, 2.5rem));
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  /* Not a flex row: as a flex item the dot wraps onto a line of its own at
     phone widths. Inline keeps it tied to the first city. */
  .hero__place {
    display: block;
    font-family: var(--font);
    font-variation-settings: "wdth" 88, "wght" 700;
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--s-6);
  }

  .hero__dot {
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.55rem;
    margin-bottom: 0.12em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 oklch(0.58 0.12 150 / 0.7);
    animation: live-pulse 2.6s var(--ease-out) infinite;
  }

  /* A slow single-property pulse on the "we're actually open" dot. It is the
     only looping motion outside the hero weather, and it is tied to a real
     claim rather than decoration. */
  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 oklch(0.58 0.12 150 / 0.7);
    }
    70%,
    100% {
      box-shadow: 0 0 0 12px oklch(0.58 0.12 150 / 0);
    }
  }

  .hero__headline {
    max-width: 16ch;
    margin-bottom: var(--s-8);
  }

  .hero__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .hero__sub {
    max-width: 52ch;
    color: var(--on-void-dim);
    font-size: var(--fs-lead);
  }

  .hero__sub strong {
    color: var(--on-void);
    font-weight: 600;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .hero__promise {
    margin-top: var(--s-6);
    font-family: var(--font);
    font-variation-settings: "wdth" 88, "wght" 600;
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-void-dim);
  }

  .hero__edge {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.5;
  }

  @media (max-width: 860px) {
    .hero__foot {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .hero__headline {
      max-width: 12ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sink,
    .hero__scene {
      animation: none;
      transform: none;
      opacity: 1;
    }
    .hero__rain {
      display: none;
    }
    .hero__dot {
      animation: none;
    }
    .hero__img {
      transform: none;
    }
  }
</style>

<script>
  // The weather loop keeps running while the tab is hidden otherwise, which
  // burns battery for nobody's benefit and can jank on return.
  const rain = document.querySelector<HTMLElement>(".hero__rain");
  if (rain) {
    document.addEventListener("visibilitychange", () => {
      const state = document.hidden ? "paused" : "running";
      rain.querySelectorAll<HTMLElement>("span").forEach((s) => {
        s.style.animationPlayState = state;
      });
    });
  }
</script>
