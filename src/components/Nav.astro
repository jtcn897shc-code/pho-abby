---
import { contact } from "../data/site";

const links = [
  { href: "#menu", label: "Menu" },
  { href: "#favourites", label: "Favourites" },
  { href: "#about", label: "About" },
  { href: "#visit", label: "Visit" },
];
---

<span id="nav-sentinel" aria-hidden="true"></span>
<header class="nav" data-nav>
  <div class="shell nav__row">
    <a class="nav__brand" href="#top">
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M5 14h22a11 11 0 0 1-22 0Z" fill="currentColor" />
        <rect x="3" y="21.5" width="26" height="2.4" rx="1.2" fill="currentColor" />
        <path
          d="M12 7.5c1.6 1.2 1.6 2.6 0 3.8M16 6c1.8 1.4 1.8 3 0 4.4M20 7.5c1.6 1.2 1.6 2.6 0 3.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          opacity="0.7"
        />
      </svg>
      {contact.name}
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="nav__phone" href={`tel:${contact.phoneTel}`}>
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.24 1Z"
        />
      </svg>
      <span class="nav__phone-num">{contact.phoneDisplay}</span>
      <span class="visually-hidden">Call {contact.name}</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    transition: background-color var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .nav__row {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: 4.25rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--on-frame);
    transition: color var(--dur-mid) var(--ease-out);
  }

  .nav__links {
    display: flex;
    gap: var(--s-6);
    margin-inline: auto;
  }

  .nav__links a {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--on-frame);
    opacity: 0.82;
    transition: opacity var(--dur-fast) var(--ease-out), color var(--dur-mid) var(--ease-out);
  }

  .nav__links a:hover {
    opacity: 1;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    color: var(--on-frame);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-mid) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .nav__phone:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    transform: translateY(-1px);
  }

  .nav__phone:active {
    transform: scale(0.97);
  }

  /* solidified state — set by the sentinel observer */
  .nav.is-solid {
    background: var(--bg);
    border-bottom-color: var(--hairline);
    box-shadow: var(--shadow-sm);
  }

  .nav.is-solid .nav__brand,
  .nav.is-solid .nav__links a,
  .nav.is-solid .nav__phone {
    color: var(--ink);
  }

  .nav.is-solid .nav__phone {
    border-color: var(--primary);
    color: var(--primary);
  }

  .nav.is-solid .nav__phone:hover {
    background: var(--primary);
    color: #fff;
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .nav__phone-num {
      display: none;
    }
    .nav__phone {
      padding: 0.5rem;
      width: 44px;
      justify-content: center;
    }
  }
</style>

<script>
  // Solidify the nav once a 1px sentinel above the hero scrolls out of view.
  // IntersectionObserver, never a scroll listener.
  const nav = document.querySelector("[data-nav]");
  const sentinel = document.getElementById("nav-sentinel");
  if (nav && sentinel) {
    const io = new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-solid", !entry.isIntersecting),
      { rootMargin: "0px 0px 0px 0px", threshold: 0 },
    );
    io.observe(sentinel);
  }
</script>
