---
import { contact } from "../data/site";
import { logos } from "../data/images";

const mark = logos.mark;
const markRev = logos.markReversed;

const links = [
  { href: "#services", label: "Services" },
  { href: "#leak-response", label: "Leak response" },
  { href: "#about", label: "About" },
  { href: "#quote", label: "Get a quote" },
];
---

<span id="nav-sentinel" aria-hidden="true"></span>
<header class="nav" data-nav>
  <div class="shell nav__row">
    <a class="nav__brand" href="#top">
      <!-- The mark carries two variants: the artwork's charcoal disappears on
           the dark hero, so the reversed one shows there and the original takes
           over once the nav solidifies. The wordmark stays live text — a raster
           wordmark at this size would be mush. -->
      <span class="nav__logo" aria-hidden="true">
        <img class="nav__logo-img nav__logo-img--rev" src={markRev} alt="" width="320" height="187" />
        <img class="nav__logo-img nav__logo-img--std" src={mark} alt="" width="320" height="187" />
      </span>
      {contact.shortName}
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="nav__phone" href={`tel:${contact.phoneTel}`}>
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.24 1Z"
        />
      </svg>
      <span class="nav__phone-num">{contact.phoneDisplay}</span>
      <span class="visually-hidden">Call {contact.name}</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    /* Pull the hero up underneath the nav so the transparent state sits over
       the dark hero instead of over the white page background — without this,
       the light nav text renders white-on-white until the first scroll. */
    margin-bottom: -4.25rem;
    z-index: var(--z-nav);
    transition: background-color var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .nav__row {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: 4.25rem;
  }

  .nav__logo {
    position: relative;
    display: block;
    /* The emblem is detail-dense (giraffe, acacia, roofline); below ~36px it
       collapses into a coloured blob. */
    height: 38px;
    aspect-ratio: 320 / 187;
    flex: 0 0 auto;
  }

  .nav__logo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity var(--dur-mid) var(--ease-out);
  }

  .nav__logo-img--std {
    opacity: 0;
  }

  .nav.is-solid .nav__logo-img--rev {
    opacity: 0;
  }

  .nav.is-solid .nav__logo-img--std {
    opacity: 1;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--on-frame);
    transition: color var(--dur-mid) var(--ease-out);
  }

  .nav__links {
    display: flex;
    gap: var(--s-6);
    margin-inline: auto;
  }

  .nav__links a {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--on-frame);
    opacity: 0.82;
    transition: opacity var(--dur-fast) var(--ease-out), color var(--dur-mid) var(--ease-out);
  }

  .nav__links a:hover {
    opacity: 1;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    color: var(--on-frame);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-mid) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .nav__phone:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
    transform: translateY(-1px);
  }

  .nav__phone:active {
    transform: scale(0.97);
  }

  /* solidified state — set by the sentinel observer */
  .nav.is-solid {
    background: var(--bg);
    border-bottom-color: var(--hairline);
    box-shadow: var(--shadow-sm);
  }

  .nav.is-solid .nav__brand,
  .nav.is-solid .nav__links a,
  .nav.is-solid .nav__phone {
    color: var(--ink);
  }

  .nav.is-solid .nav__phone {
    border-color: var(--primary-text);
    color: var(--primary-text);
  }

  .nav.is-solid .nav__phone:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .nav__phone-num {
      display: none;
    }
    .nav__phone {
      padding: 0.5rem;
      width: 44px;
      justify-content: center;
    }
  }
</style>

<script>
  // Solidify the nav once a 1px sentinel above the hero scrolls out of view.
  // IntersectionObserver, never a scroll listener.
  const nav = document.querySelector("[data-nav]");
  const sentinel = document.getElementById("nav-sentinel");
  if (nav && sentinel) {
    const io = new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-solid", !entry.isIntersecting),
      { rootMargin: "0px 0px 0px 0px", threshold: 0 },
    );
    io.observe(sentinel);
  }
</script>
