---
import { images } from "../data/images";
import Figure from "./Figure.astro";

// 7 + 5 fills the first row, then the placeholder runs full width — the
// missing photo reads as a deliberate slot rather than a gap.
const shots = [
  { fig: images.workA, span: 7, ratio: "4 / 3" },
  { fig: images.workB, span: 5, ratio: "4 / 3" },
  // Full width, so it needs a letterbox ratio — 4/3 across twelve columns is
  // a thousand pixels of empty placeholder.
  { fig: images.workC, span: 12, ratio: "21 / 9" },
];
---

<section class="section section--void work" aria-label="Recent work">
  <div class="shell section__inner">
    <header class="work__head">
      <p class="eyebrow" data-reveal="up">04 — Selected work</p>
      <h2 class="display h2" data-reveal="up" style="--i:1">
        Roofs that<br /><span class="display--ghost">hold the line.</span>
      </h2>
    </header>
  </div>

  <div class="work__track">
    {
      shots.map((s, i) => (
        <figure class="work__item" style={`--span:${s.span}; --i:${i % 2}`} data-reveal="mask">
          <div class="work__media" data-tilt="5">
            <Figure {...s.fig} ratio={s.ratio} />
          </div>
          <figcaption>{s.fig.label}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .work__head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .work__track {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(0.5rem, 1.2vw, 1rem);
    padding-inline: var(--gutter);
    max-width: calc(var(--shell) + 8vw);
    margin-inline: auto;
  }

  .work__item {
    margin: 0;
    grid-column: span var(--span);
  }

  .work__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--hairline);
  }

  .work__media :global(.figure) {
    width: 100%;
    transition: transform 700ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .work__item:hover .work__media :global(.figure) {
      transform: scale(1.05);
    }
  }

  .work__item figcaption {
    margin-top: var(--s-3);
    font-family: var(--font);
    font-variation-settings: "wdth" 88, "wght" 600;
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-void-dim);
  }

  @media (max-width: 760px) {
    .work__track {
      grid-template-columns: 1fr;
    }
    .work__item {
      grid-column: auto;
    }
  }
</style>
