---
import {
  contact,
  credentials,
  ctas,
  hours,
  hoursFootnote,
  quoteIntake,
  serviceArea,
} from "../data/site";

const to12 = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  const ap = h >= 12 ? "pm" : "am";
  const hh = h % 12 === 0 ? 12 : h % 12;
  return m === 0 ? `${hh} ${ap}` : `${hh}:${String(m).padStart(2, "0")} ${ap}`;
};
---

<section class="section section--void area" id="quote">
  <span class="ghost" aria-hidden="true">Get a quote</span>

  <div class="shell section__inner area__inner">
    <div class="area__details">
      <p class="eyebrow" data-reveal="up">05 — Where we work</p>
      <h2 class="display h2" data-reveal="up" style="--i:1">
        Six cities.<br /><span class="display--ghost-gold">One number.</span>
      </h2>

      <ul class="cities" data-reveal="up" style="--i:2">
        {serviceArea.cities.map((c, i) => <li style={`--i:${i}`}>{c}</li>)}
      </ul>

      <a class="area__phone display" href={`tel:${contact.phoneTel}`} data-reveal="up" style="--i:3">
        {contact.phoneDisplay}
      </a>
      <p class="area__response" data-reveal="up" style="--i:4">
        {contact.responseNote} · {contact.emergencyNote}
      </p>

      <dl class="hours" data-hours data-reveal="up" style="--i:5">
        {
          hours.map((h, i) => (
            <div class="hours__row" data-day={i}>
              <dt>{h.day}</dt>
              <dd>
                {to12(h.open)} – {to12(h.close)}
                <span class="hours__state" hidden />
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="hours__foot" data-reveal="up">{hoursFootnote}</p>

      <ul class="creds" data-reveal="up">
        {credentials.map((c, i) => <li style={`--i:${i}`}>{c.label}</li>)}
      </ul>
    </div>

    <!--
      Intake panel. Deliberately NOT a <form>: the build is static with no
      endpoint wired (quoteIntake.endpoint is empty), and a form that posts
      into nothing silently swallows leads — the worst possible failure on a
      contractor site. Wire an endpoint and this becomes a real form.
    -->
    <aside class="intake" data-reveal="depth" data-tilt="3">
      <h3 class="display intake__title">Get a quote</h3>
      <p class="intake__lede">
        Send these five things and we can usually tell you what you're dealing
        with before we roll a truck.
      </p>

      <ol class="intake__list">
        {
          quoteIntake.fields.map((f, i) => (
            <li style={`--i:${i}`}>
              <span class="intake__field">{f.label}</span>
              <span class="intake__hint">{f.hint}</span>
            </li>
          ))
        }
      </ol>

      <p class="intake__safety">{quoteIntake.safetyNote}</p>

      <div class="intake__cta">
        <a class="btn" href={ctas.emergency.href}>
          Call now
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="btn--ghost" href={ctas.message.href} target="_blank" rel="noopener">
          Send photos
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .area__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .cities {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--s-8);
  }

  .cities li {
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    font-family: var(--font);
    font-variation-settings: "wdth" 90, "wght" 600;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cities li:hover {
      border-color: var(--gold);
      color: var(--gold);
    }
  }

  .area__phone {
    display: inline-block;
    margin-top: var(--s-8);
    font-size: clamp(2.2rem, 6vw, 4rem);
    color: var(--gold);
    text-decoration: none;
    min-height: 48px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .area__phone:hover {
      color: var(--gold-bright);
    }
  }

  .area__response {
    margin-top: var(--s-2);
    font-size: 0.88rem;
    color: var(--on-void-dim);
    max-width: 44ch;
  }

  .hours {
    margin-top: var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.92rem;
  }

  .hours__row dt {
    color: var(--on-void-dim);
  }

  .hours__row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .hours__row.is-today dt,
  .hours__row.is-today dd {
    color: var(--on-void);
    font-weight: 700;
  }

  .hours__row.is-today dt {
    position: relative;
    padding-left: 1rem;
  }

  .hours__row.is-today dt::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }

  .hours__state {
    margin-left: 0.5rem;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .hours__state[data-open="yes"] {
    color: var(--green);
  }

  .hours__state[data-open="no"] {
    color: var(--on-void-dim);
  }

  .hours__foot {
    margin-top: var(--s-3);
    font-size: 0.8rem;
    color: var(--on-void-dim);
    max-width: 46ch;
  }

  .creds {
    list-style: none;
    padding: 0;
    margin-top: var(--s-8);
    display: grid;
    gap: 0.55rem;
  }

  .creds li {
    position: relative;
    padding-left: 1.65rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .creds li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.26em;
    width: 0.5rem;
    height: 0.85rem;
    border: solid var(--green);
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }

  /* ---- intake panel ---- */
  .intake {
    position: sticky;
    top: 6rem;
    background: var(--void-2);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3.5vw, 2.25rem);
    box-shadow: var(--shadow-lg);
  }

  .intake__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .intake__lede {
    margin-top: var(--s-3);
    color: var(--on-void-dim);
    font-size: 0.95rem;
  }

  .intake__list {
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: intake;
  }

  .intake__list li {
    counter-increment: intake;
    position: relative;
    padding: 0.7rem 0 0.7rem 2.4rem;
    border-top: 1px solid var(--hairline);
  }

  .intake__list li:first-child {
    border-top: 0;
  }

  .intake__list li::before {
    content: counter(intake, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.75rem;
    font-family: var(--font);
    font-variation-settings: "wdth" 88, "wght" 800;
    font-size: 0.8rem;
    color: var(--gold);
  }

  .intake__field {
    display: block;
    font-weight: 700;
  }

  .intake__hint {
    display: block;
    font-size: 0.84rem;
    color: var(--on-void-dim);
    line-height: 1.45;
  }

  .intake__safety {
    margin-top: var(--s-6);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius);
    background: oklch(0.58 0.12 150 / 0.12);
    border-left: 2px solid var(--green);
    color: var(--on-void);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .intake__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  @media (max-width: 980px) {
    .area__inner {
      grid-template-columns: 1fr;
    }
    .intake {
      position: static;
      order: -1;
    }
  }
</style>

<script>
  // Mark today's row and compute open/closed in America/Vancouver client-side
  // (a build-time "today" would be wrong). Colour is never the only signal —
  // the day goes bold and an "· open now / closed now" label is added.
  type Row = { open: string; close: string };
  const rows: Row[] = [
    { open: "07:00", close: "18:00" },
    { open: "07:00", close: "18:00" },
    { open: "07:00", close: "18:00" },
    { open: "07:00", close: "18:00" },
    { open: "07:00", close: "18:00" },
    { open: "08:00", close: "16:00" },
    { open: "08:00", close: "16:00" },
  ];

  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/Vancouver",
    weekday: "short",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).formatToParts(new Date());

  const wd = parts.find((p) => p.type === "weekday")?.value ?? "Mon";
  const hour = Number(parts.find((p) => p.type === "hour")?.value ?? "0");
  const min = Number(parts.find((p) => p.type === "minute")?.value ?? "0");
  const nowMin = hour * 60 + min;

  const order = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const idx = order.indexOf(wd);

  if (idx > -1) {
    const container = document.querySelector("[data-hours]");
    const row = container?.querySelector<HTMLElement>(`[data-day="${idx}"]`);
    if (row) {
      row.classList.add("is-today");
      const [oh, om] = rows[idx].open.split(":").map(Number);
      const [ch, cm] = rows[idx].close.split(":").map(Number);
      const isOpen = nowMin >= oh * 60 + om && nowMin < ch * 60 + cm;
      const state = row.querySelector<HTMLElement>(".hours__state");
      if (state) {
        state.hidden = false;
        state.textContent = isOpen ? "· open now" : "· closed now";
        state.dataset.open = isOpen ? "yes" : "no";
      }
    }
  }
</script>
